# ─── Payload CMS ───
PAYLOAD_SECRET=your-secret-here-at-least-32-chars
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Database ───
# See docs/adr/ADR-009-demo-vs-production-database.md for the full rationale.
#
# Local dev (SQLite file, default):
DATABASE_URL=file:./payload.db
#
# Demo / stakeholder feedback (hosted libSQL via Turso — persists across Vercel deploys):
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=replace-with-turso-db-auth-token
#
# Production / go-live (PostgreSQL):
# DATABASE_URL=postgresql://user:***@host:5432/mfa_food
# (DATABASE_AUTH_TOKEN is ignored when DATABASE_URL starts with postgres)

# ─── Email (Resend via SMTP or Nodemailer) ───
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace-with-your-api-key
FROM_EMAIL=noreply@foodagency.mt
FROM_NAME=Malta Food Experience
RESEND_API_KEY=replace-with-your-api-key

# ─── Stripe Payments ───
STRIPE_SECRET_KEY=replace-with-your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-your-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-your-webhook-secret

# ─── Auth ───
NEXTAUTH_SECRET=replace-with-your-secret-value

# ─── First-admin bootstrap (seed) ───
# Used by `npm run db:seed` to create the first admin user.
# If unset, seed skips admin creation — create the first admin via
# the Payload admin UI at /admin (first visitor becomes admin).
# DO NOT commit real values. Set these in your local .env file.
ADMIN_BOOTSTRAP_EMAIL=admin@foodagency.mt
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# ─── Features (optional) ───
NEXT_PUBLIC_ENABLE_GOOGLE_TRANSLATE=false
NEXT_PUBLIC_GOOGLE_TRANSLATE_API_KEY=
