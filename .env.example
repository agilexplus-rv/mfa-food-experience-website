# ─── Payload CMS ───
PAYLOAD_SECRET=your-secret-here-at-least-32-chars
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Database ───
# SQLite (default for local dev):
DATABASE_URL=file:./payload.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/mfa_food

# ─── Email (Resend via SMTP or Nodemailer) ───
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace-with-your-api-key
FROM_EMAIL=noreply@foodagency.mt
FROM_NAME=Malta Food Experience
RESEND_API_KEY=replace-with-your-api-key

# ─── Stripe Payments ───
STRIPE_SECRET_KEY=replace-with-your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-your-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-your-webhook-secret

# ─── Auth ───
NEXTAUTH_SECRET=replace-with-your-secret-value

# ─── Features (optional) ───
NEXT_PUBLIC_ENABLE_GOOGLE_TRANSLATE=false
NEXT_PUBLIC_GOOGLE_TRANSLATE_API_KEY=
